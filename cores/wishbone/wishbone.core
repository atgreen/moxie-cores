CAPI=2:

name : moxielogic:moxie-cores:wishbone:0.1.0
description : Wishbone interconnect and watchdog
license : GPL-2.0-only

filesets:
  rtl:
    files:
      - wb_intercon.v
      - wb_watchdog.v
    file_type : verilogSource

  waiver:
    files:
      - verilator_waiver.vlt
    file_type : vlt

targets:
  default:
    filesets : [rtl, "tool_verilator? (waiver)"]

  lint:
    description : Check the RTL with Verilator
    default_tool : verilator
    filesets : [rtl, waiver]
    tools:
      verilator:
        mode : lint-only
    toplevel : wb_intercon
