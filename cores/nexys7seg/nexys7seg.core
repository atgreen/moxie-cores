CAPI=2:

name : moxielogic:moxie-cores:nexys7seg:0.1.0
description : The Nexys boards' seven-segment display, from Wishbone
license : GPL-2.0-only

filesets:
  rtl:
    files:
      - nexys7seg.v
    file_type : verilogSource

