+/* True if X, a MEM or a constant address, is data that -mgp reaches
+   as an offset from _gp in $r13: a writable variable, perhaps plus a
+   constant, that is not an undefined weak symbol or in a section of
+   its own.  The linker puts _gp 32K into .data, so that it reaches
+   the first 64K of .data and .bss.  */
+
+static bool
+moxie_gprel_p (rtx x)
+{
+  tree decl;
+
+  if (!TARGET_GP)
+    return false;
+  if (MEM_P (x))
+    x = XEXP (x, 0);
+  if (GET_CODE (x) == CONST && GET_CODE (XEXP (x, 0)) == PLUS
+      && CONST_INT_P (XEXP (XEXP (x, 0), 1)))
+    x = XEXP (XEXP (x, 0), 0);
+  if (GET_CODE (x) != SYMBOL_REF || SYMBOL_REF_FUNCTION_P (x))
+    return false;
+  decl = SYMBOL_REF_DECL (x);
+  if (decl == NULL_TREE || TREE_CODE (decl) != VAR_DECL
+      || TREE_READONLY (decl)
+      || (DECL_WEAK (decl) && DECL_EXTERNAL (decl)))
+    return false;
+  if (DECL_SECTION_NAME (decl))
+    {
+      const char *name = DECL_SECTION_NAME (decl);
+      return startswith (name, ".data") || startswith (name, ".bss");
+    }
+  return true;
+}
