+
+/* The pushm or popm (PUSH false) of PAR, a PARALLEL that moves $sp and
+   then stores or loads a run of registers.  */
+
+const char *
+moxie_output_multiple (rtx par, bool push)
+{
+  static char buf[64];
+  int i, lo = FIRST_PSEUDO_REGISTER, hi = 0;
+
+  for (i = 1; i < XVECLEN (par, 0); i++)
+    {
+      rtx set = XVECEXP (par, 0, i);
+      int regno = REGNO (push ? SET_SRC (set) : SET_DEST (set));
+      lo = MIN (lo, regno);
+      hi = MAX (hi, regno);
+    }
+  sprintf (buf, "%s\t%s, %s", push ? "pushm" : "popm",
+	   reg_names[lo], reg_names[hi]);
+  return buf;
+}
+
+/* True if MEM, the memory operand of an ldo.l or sto.l of REG, has a
+   2-byte form with -mcompact: an offset of 0 to 60 from $r0-$r7 to or
+   from $r0-$r7, or of -4 to -128 from $fp.  */
+
+static bool
+moxie_short_offset_p (rtx mem, rtx reg)
+{
+  rtx addr = XEXP (mem, 0);
+  HOST_WIDE_INT off;
+  int base;
+
+  if (!TARGET_COMPACT || GET_MODE (mem) != SImode || !REG_P (reg)
+      || GET_CODE (addr) != PLUS || !REG_P (XEXP (addr, 0))
+      || !CONST_INT_P (XEXP (addr, 1)))
+    return false;
+  off = INTVAL (XEXP (addr, 1));
+  base = REGNO (XEXP (addr, 0));
+  if (off & 3)
+    return false;
+  if (base == MOXIE_FP)
+    return off >= -128 && off <= -4;
+  return (off >= 0 && off <= 60
+	  && IN_RANGE (base, MOXIE_R0, MOXIE_R0 + 7)
+	  && IN_RANGE (REGNO (reg), MOXIE_R0, MOXIE_R0 + 7));
+}
+
+/* The length of INSN, a *movsi, *movhi or *movqi, as the assembler
+   will encode it.  */
+
+int
+moxie_move_length (rtx_insn *insn)
+{
+  rtx *ops = recog_data.operand;
+  bool si;
+
+  extract_constrain_insn_cached (insn);
+  si = GET_MODE (ops[0]) == SImode;
+  switch (which_alternative)
+    {
+    case 2:			/* ldi */
+      if (si && TARGET_COMPACT && CONST_INT_P (ops[1]))
+	{
+	  HOST_WIDE_INT v = INTVAL (ops[1]);
+	  if (IN_RANGE (v, -64, 63))
+	    return 2;
+	  if (IN_RANGE (v, -32768, 32767))
+	    return 4;
+	}
+      return si && moxie_gprel_p (ops[1]) ? 4 : 6;
+    case 4:			/* sta */
+      return moxie_gprel_p (ops[0]) ? 4 : 6;
+    case 6:			/* lda */
+      return moxie_gprel_p (ops[1]) ? 4 : 6;
+    case 7:			/* sto */
+      return moxie_short_offset_p (ops[0], ops[1]) ? 2 : 4;
+    case 8:			/* ldo */
+      return moxie_short_offset_p (ops[1], ops[0]) ? 2 : 4;
+    default:
+      return 2;
+    }
+}
