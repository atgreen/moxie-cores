+/* The registers from LO to HI that the prologue saves form a run that
+   pushm and popm can move, if there are two or more of them.  Return
+   the last register of the run that starts at LO.  */
+
+static int
+moxie_saved_run (int lo)
+{
+  int hi = lo;
+
+  if (!TARGET_COMPACT || crtl->calls_eh_return || lo < MOXIE_R0)
+    return lo;
+  while (hi + 1 <= MOXIE_R13
+	 && df_regs_ever_live_p (hi + 1) && !call_used_or_fixed_reg_p (hi + 1))
+    hi++;
+  return hi;
+}
