+/* With -mcompact, ldi.l, ldo.l and sto.l take their short forms where
+   the operands fit.  */
+
+static int compact = 0;
+
+/* .option compact and .option nocompact turn -mcompact on and off.  */
+
+static void
+s_option (int ignore ATTRIBUTE_UNUSED)
+{
+  char *name;
+  char c = get_symbol_name (&name);
+
+  if (strcmp (name, "compact") == 0)
+    compact = 1;
+  else if (strcmp (name, "nocompact") == 0)
+    compact = 0;
+  else
+    as_bad (_("unknown .option `%s'"), name);
+  restore_line_pointer (c);
+  demand_empty_rest_of_line ();
+}
+
+/* Parse an offset: an expression, or %gprel(expression) for an offset
+   from _gp.  */
+
+static char *
+parse_offset (char *s, expressionS *exp, bfd_reloc_code_real_type *reloc)
+{
+  if (strncasecmp (s, "%gprel(", 7) == 0)
+    {
+      s = parse_exp_save_ilp (s + 7, exp);
+      if (*s == ')')
+	s++;
+      else
+	as_bad (_("missing closing parenthesis"));
+      *reloc = BFD_RELOC_GPREL16;
+    }
+  else
+    {
+      s = parse_exp_save_ilp (s, exp);
+      *reloc = BFD_RELOC_16;
+    }
+  return s;
+}
+
+/* The 3-bit register fields of the short ldo.l and sto.l name $r0-$r7.  */
+
+static int
+short_reg (int reg)
+{
+  return reg >= 2 && reg <= 9 ? reg - 2 : -1;
+}
+
+/* The short form of ldo.l $rA, OFFSET($rB) (STORE false) or sto.l
+   OFFSET($rA), $rB (STORE true), or -1 if there is none.  DATA is the
+   register loaded or stored and BASE the address register.  */
+
+static int
+short_offset_insn (bool store, int data, int base, offsetT v)
+{
+  if (base == 0 && v >= -128 && v <= -4 && (v & 3) == 0)
+    {
+      int k = -v / 4 - 1;
+      return (((store ? 0x52 : 0x50) | (k >> 4)) << 8) | (data << 4) | (k & 15);
+    }
+  if (short_reg (data) >= 0 && short_reg (base) >= 0
+      && v >= 0 && v <= 60 && (v & 3) == 0)
+    {
+      int o = v / 4;
+      int a = short_reg (store ? base : data), b = short_reg (store ? data : base);
+      return (((store ? 0x4c : 0x48) | (o >> 2)) << 8)
+	| ((o >> 1 & 1) << 7) | (a << 4) | ((o & 1) << 3) | b;
+    }
+  return -1;
+}
